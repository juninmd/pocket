{
  "manifest_version": 2,
  "name": "Pocket-like Extension",
  "version": "1.0",
  "description": "A Firefox extension similar to Pocket.",
  "icons": {
    "48": "icons/icon-48.png"
  },
  "browser_action": {
    "default_icon": "icons/icon-48.png",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "<all_urls>"
  ]
}