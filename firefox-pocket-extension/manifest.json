{
  "manifest_version": 2,
  "name": "Pocket-like Extension",
  "version": "1.0",
  "description": "Uma extensão para Firefox similar ao Pocket.",
  "icons": {
    "48": "icons/icon-48.png"
  },
  "browser_action": {
    "default_icon": "icons/icon-48.png",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Salvar página / Abrir Menu"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "unlimitedStorage",
    "bookmarks",
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "pocket-like@example.com",
      "strict_min_version": "109.0"
    }
  }
}