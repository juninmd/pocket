+/* Shared controls */
+:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
+
+.primary-btn, .secondary-btn {
+  padding: 10px 20px; border-radius: var(--radius-sm); font: 600 0.9rem var(--font-main);
+  cursor: pointer; transition: all 0.2s; border: 1px solid var(--border-light);
+}
+.primary-btn { background: var(--primary-gradient); color: #fff; border-color: transparent; }
+.primary-btn:hover { box-shadow: 0 6px 18px rgba(102, 126, 234, 0.4); transform: translateY(-1px); }
+.secondary-btn { background: rgba(255, 255, 255, 0.05); color: var(--text-main); }
+.secondary-btn:hover { background: rgba(255, 255, 255, 0.1); }
+.primary-btn.wide { width: 100%; padding: 12px; font-size: 1rem; }
+
+.btn { border: 1px solid var(--border-light); font-family: var(--font-main); color: #fff; }
+.btn.secondary { background: rgba(255, 255, 255, 0.06); }
+.btn.secondary:hover:not(:disabled) { background: rgba(255, 255, 255, 0.12); }
+.btn.accent { background: var(--primary-gradient); border-color: transparent; }
+.btn.warm { background: linear-gradient(135deg, #ff6b6b 0%, #ffa502 100%); border-color: transparent; }
+.btn.accent.ok { background: #2e9e5b; }
+.btn.ghost { background: rgba(255, 255, 255, 0.05); color: var(--text-secondary); padding: 8px 14px; }
+.btn.ghost:hover { color: #fff; background: rgba(255, 255, 255, 0.1); }
+.btn:hover:not(:disabled) { transform: translateY(-1px); }
+
+.search-bar.full { width: 100%; box-sizing: border-box; border-radius: var(--radius-sm); }
+.search-bar.grow { flex: 1; width: auto; border-radius: var(--radius-sm); }
+select.search-bar option { background: var(--bg-dark); color: var(--text-main); }
+
+.field-label { display: block; margin: 16px 0 8px; font-weight: 600; color: var(--text-main); }
+.form-stack { display: flex; flex-direction: column; gap: 4px; }
+.form-stack .field-label:first-child { margin-top: 0; }
+.hint { color: var(--text-secondary); margin: 0 0 10px; line-height: 1.5; }
+.hint.small { font-size: 0.8rem; margin-top: 8px; }
+.hint.right { text-align: right; font-size: 0.75rem; margin: 8px 0 0; }
+.hint a, .panel a { color: var(--accent); }
+.eyebrow { color: var(--accent); font-weight: 700; letter-spacing: 0.08em; font-size: 0.75rem; margin-bottom: 10px; }
+
+/* Cards */
+.card.clickable { cursor: pointer; }
+.card-excerpt {
+  font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 12px; line-height: 1.5;
+  display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
+}
+.card-tag.ai { background: rgba(102, 126, 234, 0.12); color: #aab6ff; border-color: rgba(102, 126, 234, 0.3); }
+
+/* Collections */
+.stack { display: flex; flex-direction: column; gap: 32px; }
+.folder-nav { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }
+.folder-nav h2 { margin: 0; }
+.breadcrumbs { display: flex; gap: 8px; align-items: center; color: var(--text-muted); }
+.crumb { cursor: pointer; color: var(--text-secondary); }
+.crumb:hover { color: #fff; }
+.crumb.current { color: var(--primary); font-weight: 700; }
+.section-title { margin: 0 0 16px; padding-bottom: 10px; border-bottom: 1px solid var(--border-light); }
+.grid.tiles { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px; }
+.grid.tiles.small { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 14px; }
+.tile { box-sizing: border-box; cursor: pointer; padding: 22px 16px; align-items: center; justify-content: center; text-align: center; }
+.tile h3 { margin: 0; font-size: 1.05rem; }
+.tile p { margin: 6px 0 0; color: var(--text-secondary); font-size: 0.85rem; }
+.tile-icon { font-size: 2.4rem; margin-bottom: 10px; }
+
+/* Discover */
+.discover { display: flex; justify-content: center; }
+.discover-card { max-width: 640px; width: 100%; }
+.discover-card:hover { transform: none; }
+.discover-link { text-decoration: none; color: inherit; display: block; }
+.discover-image { height: 300px; }
+.discover-title { font-size: 1.6rem; }
+.discover-excerpt { line-height: 1.6; color: var(--text-secondary); margin: 0; }
+.discover-footer { border-top: 1px solid var(--border-light); flex: none; }
+
+/* Settings */
+.settings { max-width: 680px; }
+.panel { padding: 28px; }
+.panel h2 { margin-top: 0; }
+.panel-section { margin-bottom: 28px; padding-bottom: 24px; border-bottom: 1px solid var(--border-light); }
+.btn-row { display: flex; gap: 10px; flex-wrap: wrap; }
+.btn-row.nowrap { flex-wrap: nowrap; }
+.progress-box { margin-top: 14px; padding: 16px; background: rgba(255, 255, 255, 0.04); border-radius: var(--radius-sm); border: 1px solid var(--border-light); }
+.progress-head { display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 0.85rem; font-weight: 600; }
+.progress-track { height: 8px; background: rgba(255, 255, 255, 0.1); border-radius: 4px; overflow: hidden; }
+.progress-bar { height: 100%; background: var(--primary-gradient); transition: width 0.3s ease; box-shadow: 0 0 10px rgba(102, 126, 234, 0.5); }
+
+/* Modal content */
+.preview { max-height: 400px; overflow-y: auto; }
+.preview-grid { display: grid; grid-template-columns: 1fr auto; gap: 8px; margin-top: 14px; }
+.preview-folder, .preview-count { padding: 8px 10px; background: rgba(255, 255, 255, 0.05); border-radius: 6px; }
+.preview-count { text-align: right; color: var(--text-secondary); }
+.preview-debug { margin-top: 18px; border-top: 1px solid var(--border-light); padding-top: 10px; }
+.preview-debug summary { cursor: pointer; color: var(--text-secondary); font-size: 0.9rem; }
+.preview-debug pre { background: #14161b; padding: 10px; border-radius: 6px; font-size: 0.8rem; overflow: auto; max-height: 200px; white-space: pre-wrap; }
+.tag-list { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 10px; }
+.chip { background: rgba(102, 126, 234, 0.18); color: #c3ccff; padding: 3px 10px; border-radius: 14px; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 6px; }
+.chip button { border: 0; background: none; color: inherit; cursor: pointer; font-weight: 700; padding: 0; }
+
+/* Responsive & motion */
+@media (max-width: 860px) {
+  .dashboard-container { flex-direction: column; }
+  .sidebar { width: auto; height: auto; position: static; flex-direction: row; flex-wrap: wrap; gap: 4px; padding: 12px; }
+  .sidebar .logo { margin: 0 12px 0 0; width: 100%; }
+  .sidebar .nav-item { width: auto; padding: 8px 12px; border-left: 0; }
+  .sidebar .nav-divider { display: none; }
+  .main-content { padding: 24px 16px; }
+  .header { flex-direction: column; align-items: stretch; gap: 16px; }
+  .search-bar { width: 100%; box-sizing: border-box; }
+  .card-actions { opacity: 1; transform: none; }
+}
+@media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
